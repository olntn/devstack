def clean(s):
    # Подпись приходит от агента: ESC-последовательности и т.п. — в пробелы.
    s = s if isinstance(s, str) else ""
    return "".join(c if c.isprintable() else " " for c in s)[:80]


def host_ports(p):
    # Тот же номер; занят — следующие. Привилегированный (<1024) без root не
    # открыть — пробуем 8000+p (80 -> 8080, 443 -> 8443).
    yield p
    base = p if p >= 1024 else p + 8000
    for i in range(1 if base == p else 0, 10):
        if base + i <= 65535:
            yield base + i


class Status:
    """Человекочитаемое состояние для `devstack ports` (атомарная перезапись)."""

    def __init__(self, path):
        self.path = path

    def write(self, head, rows=()):
        tmp = self.path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("\n".join([head] + list(rows)) + "\n")
        os.replace(tmp, self.path)

    def clear(self):
        try:
            os.unlink(self.path)
        except OSError:
            pass


class Forwards:
    """Порты контейнера -> слушатели 127.0.0.1 на хосте."""

    def __init__(self, a, mux, st):
        self.a, self.mux, self.st = a, mux, st
        self.fw = {}        # порт контейнера -> [порт хоста, сервер, подпись]
        self.busy = {}      # порт контейнера -> подпись (свободного порта хоста нет)

    async def apply(self, items):
        want = {}
        for it in items if isinstance(items, list) else ():
            p = it.get("port") if isinstance(it, dict) else None
            if type(p) is int and 1 <= p <= 65535:
                want[p] = clean(it.get("label"))
                if len(want) >= MAX_PORTS:
                    break
        for p in [p for p in self.fw if p not in want]:
            hp, srv, _ = self.fw.pop(p)
            srv.close()
            log("- %d (был на localhost:%d)" % (p, hp))
        self.busy = {}
        for p, label in sorted(want.items()):
            if p in self.fw:
                self.fw[p][2] = label
                continue
            hp, srv = await self.listen(p)
            if srv is None:
                self.busy[p] = label
                log("! %d: на хосте нет свободного порта (%d и следующие) — не пробрасываю" % (p, p))
                continue
            self.fw[p] = [hp, srv, label]
            log(("+ %d -> localhost:%d%s  %s" % (
                p, hp, "" if hp == p else " (%d на хосте недоступен)" % p, label)).rstrip())
        self.publish()

    async def listen(self, p):
        for hp in host_ports(p):
            try:
                srv = await asyncio.start_server(
                    lambda r, w, p=p: self.client(p, r, w), "127.0.0.1", hp)
                return hp, srv
            except OSError:
                continue
        return None, None

    async def client(self, p, r, w):
        if self.mux.dead:
            w.close()
            return
        ch = self.mux.open_chan(w)
        await self.mux.send(OPEN, ch, struct.pack("!H", p))
        await self.mux.pump(ch, r)

    def publish(self):
        rows = []
        for p in sorted(self.fw):
            hp, _, label = self.fw[p]
            note = "" if hp == p else "  (%d на хосте недоступен)" % p
            rows.append(("%5d -> localhost:%-5d%s  %s" % (p, hp, note, label)).rstrip())
        for p in sorted(self.busy):
            rows.append(("%5d -> НЕ проброшен: на хосте нет свободного порта  %s"
                         % (p, self.busy[p])).rstrip())
        self.st.write("подключён к %s" % self.a.container,
                      rows or ["(в контейнере пока никто не слушает порт)"])

    def close_all(self):
        for hp, srv, _ in self.fw.values():
            srv.close()
        self.fw, self.busy = {}, {}


async def container_state(a):
    try:
        p = await asyncio.create_subprocess_exec(
            a.engine, "container", "inspect", "--format", "{{.State.Running}}", a.container,
            stdout=asyncio.subprocess.PIPE, stderr=asyncio.subprocess.DEVNULL)
        out, _ = await p.communicate()
    except OSError:
        return "absent"
    if p.returncode != 0:
        return "absent"
    return "running" if out.strip() == b"true" else "stopped"


async def session(a, st, src):
    """Один exec в контейнер. True — агент успел ответить (связь была)."""
    proc = await asyncio.create_subprocess_exec(
        a.engine, "exec", "-i", a.container, "python3", "-c", src, "agent",
        stdin=asyncio.subprocess.PIPE, stdout=asyncio.subprocess.PIPE, limit=2 * MAX_FRAME)
    mux = Mux(proc.stdout, proc.stdin)
    fw = Forwards(a, mux, st)
    hello = False
    try:
        t, _, data = await asyncio.wait_for(mux.recv(), 60)
        info = json.loads(data) if t == HELLO else None
        if not isinstance(info, dict) or info.get("proto") != PROTO:
            raise ProtoError("агент ответил не тем (версия протокола?)")
        hello = True
        log("подключён к %s" % a.container)
        fw.publish()
        while True:
            t, ch, data = await mux.recv()
            if t == PORTS:
                await fw.apply(json.loads(data))
            elif t == DATA:
                await mux.on_data(ch, data)
            elif t == EOF:
                mux.on_eof(ch)
            elif t == CLOSE:
                mux.drop(ch)
            else:
                raise ProtoError("неизвестный кадр %d" % t)
    except asyncio.IncompleteReadError:
        why = "связь с агентом оборвалась" if hello else "агент не запустился (в контейнере нужен python3 >= 3.7)"
    except asyncio.TimeoutError:
        why = "агент не ответил за 60 с"
    except (ProtoError, ValueError) as e:
        why = "сбой протокола: %s" % e
    finally:
        fw.close_all()
        mux.close_all()
        try:
            proc.stdin.close()
        except Exception:
            pass
        try:
            await asyncio.wait_for(proc.wait(), 2)
        except asyncio.TimeoutError:
            try:
                proc.kill()
            except ProcessLookupError:
                pass
            await proc.wait()
    log(why)
    st.write("нет связи с агентом: %s — переподключаюсь" % why)
    return hello


async def host_loop(a, st):
    src = open(os.path.abspath(__file__), encoding="utf-8").read()
    down_since, backoff, fails = None, 1, 0
    while True:
        state = await container_state(a)
        if state != "running":
            down_since = down_since or time.monotonic()
            if time.monotonic() - down_since > a.wait:
                log("контейнер %s не запущен %d с — выхожу" % (a.container, a.wait))
                return
            st.write("жду контейнер %s (%s)" % (
                a.container, "остановлен" if state == "stopped" else "его нет"))
            await asyncio.sleep(3)
            continue
        down_since = None
        t0 = time.monotonic()
        try:
            ok = await session(a, st, src)
        except asyncio.CancelledError:
            raise
        except Exception as e:      # сбой самого host — не повод умирать молча
            log("ошибка сессии: %r" % (e,))
            ok = False
        fails = 0 if ok else fails + 1
        if fails >= 5:
            log("агент 5 раз подряд не запустился — выхожу (подробности выше)")
            return
        backoff = 1 if time.monotonic() - t0 > 30 else min(backoff * 2, 30)
        await asyncio.sleep(backoff)


async def host_main(a):
    try:
        os.setsid()             # своя сессия: закрытие терминала нас не касается
    except OSError:
        pass
    # pid-файл и есть замок: второй экземпляр на тот же проект молча выходит.
    fd = os.open(os.path.join(a.state, ".portfwd.pid"), os.O_RDWR | os.O_CREAT, 0o644)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return
    os.ftruncate(fd, 0)
    os.write(fd, ("%d %s %s\n" % (os.getpid(), a.version, a.engine)).encode())
    st = Status(os.path.join(a.state, ".portfwd.status"))
    task = asyncio.current_task()
    loop = asyncio.get_running_loop()
    for s in (signal.SIGTERM, signal.SIGINT):
        loop.add_signal_handler(s, task.cancel)
    log("старт: %s exec %s (devstack %s)" % (a.engine, a.container, a.version))
    try:
        await host_loop(a, st)
    except asyncio.CancelledError:
        log("остановлен")
    finally:
        st.clear()
        os.ftruncate(fd, 0)


def main():
    global ROLE
    if sys.argv[1:2] == ["agent"]:
        ROLE = "agent"
        asyncio.run(agent_main())
        return
    ap = argparse.ArgumentParser(description="devstack: автопроброс портов контейнера")
    ap.add_argument("role", choices=["host"])
    ap.add_argument("--engine", required=True)
    ap.add_argument("--container", required=True)
    ap.add_argument("--state", required=True, help="папка состояния проекта")
    ap.add_argument("--version", default="")
    ap.add_argument("--wait", type=int, default=600,
                    help="сколько секунд ждать незапущенный контейнер")
    asyncio.run(host_main(ap.parse_args()))


if __name__ == "__main__":
    main()
